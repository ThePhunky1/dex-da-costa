NEXT_PUBLIC_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
# Leave empty until the deployment is reviewed and approved.
NEXT_PUBLIC_ROUTER_ADDRESS=
# Keep false for Elysium. Local mode is exclusively for an Anvil demo.
NEXT_PUBLIC_LOCAL_DEMO=false
NEXT_PUBLIC_LOCAL_USDC_ADDRESS=
# Server-only secret: create an Alchemy app for Kinetiq Elysium Testnet (99801).
# Never prefix this with NEXT_PUBLIC_. Public RPC remains the fallback.
ALCHEMY_ELYSIUM_API_KEY=
# Optional comma-separated trusted HTTPS endpoints, all serving chain 99801.
ELYSIUM_FALLBACK_RPC_URLS=
